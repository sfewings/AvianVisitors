# Copy to .env and edit. Consumed by docker-compose.yml.
#
# Everything here is written into birdnet.conf every time the container starts,
# and overrides whatever the web UI has. Delete a line to hand that setting back
# to the UI.

# ---- required ---------------------------------------------------------------
# Only go to 4 decimal places. Used to weight the species list by location.
LATITUDE=-31.9523
LONGITUDE=115.8613

# ---- basics -----------------------------------------------------------------
TZ=Australia/Perth
SITE_NAME=AvianVisitors

# ---- where the container keeps its data -------------------------------------
# All host directories, so everything is visible and backup-able with ordinary
# tools rather than living inside a Docker named volume. Relative paths are
# resolved against the directory holding docker-compose.yml.
#
# DATA_DIR is small and is the one worth backing up: birds.db, BirdDB.txt, the
# species lists and the notification templates.
#
# RECORDINGS_DIR grows without bound - audio, extractions and charts. Point it at
# whichever disk has room; an external drive or a different mount is a good idea
# on a Pi with a small SD card.
#
# Both are created on first start and chowned to the container's uid 1000. Keep
# them out of the build context if you move them inside the repo: see
# .dockerignore.
DATA_DIR=./data
RECORDINGS_DIR=./recordings

# ---- illustration assets ----------------------------------------------------
# Bind mounted read-only rather than baked into the image: it is ~491MB, and
# keeping it out means a rebuild does not re-copy half a gigabyte and a
# regenerated set appears on restart with no rebuild at all.
#
# The default is the copy in this repo. Point it at a different directory to swap
# in another set, e.g. a regional one from avian/scripts/pregen.py. It must
# contain favicon.png and an illustrations/ directory; the container refuses to
# start otherwise, because without illustrations the collage has nothing to draw.
ASSETS_DIR=./avian/assets

# ---- audio source -----------------------------------------------------------
# Pick one.
#
# (a) USB microphone. Run `arecord -l` ON THE HOST:
#
#       card 3: UM02 [UM02], device 0: USB Audio [USB Audio]
#            ^   ^^^^
#            |   `-- card NAME  -> plughw:CARD=UM02,DEV=0   (recommended)
#            `------ card NUMBER -> plughw:3,0
#
#     Prefer the CARD=<name> form. Card numbers are assigned in probe order and
#     change when you re-plug the device or add another sound card, at which
#     point a numeric REC_CARD silently stops working: arecord fails with
#     "audio open error: No such file or directory".
#
#     Do NOT use "default": that routes through PulseAudio, which the container
#     deliberately does not run.
#
#     The container validates this at startup and lists what it can actually
#     see, so `docker compose logs | grep avian-init` will tell you if it is
#     wrong.
#     Recording ONLY (no live stream): point REC_CARD straight at the hardware
#     and leave ALSA_HW_DEVICE empty. Simplest, and what most people want.
REC_CARD=plughw:CARD=UM02,DEV=0
RTSP_STREAM=

#     Recording AND the live stream: an ALSA capture device admits exactly one
#     reader, so arecord and ffmpeg cannot both open the mic and whichever
#     starts second logs "Device or resource busy" forever. Upstream avoids this
#     with PulseAudio, which this container does not run.
#
#     Instead, set ALSA_HW_DEVICE to the RAW hardware (hw:, not plughw:) and set
#     REC_CARD=default. The container then builds an ALSA dsnoop device, which
#     fans one capture stream out to both readers with no sound server:
#
#       ALSA_HW_DEVICE=hw:CARD=UM02,DEV=0
#       REC_CARD=default
#
#     dsnoop cannot convert, so its channel count must match the hardware.
#     Default is 1: check what `arecord -l`/the recording log reports for your
#     mic ("Mono" or "Stereo") and set ALSA_HW_CHANNELS=2 if needed.
ALSA_HW_DEVICE=
ALSA_HW_CHANNELS=1
ALSA_HW_RATE=48000

# (b) RTSP network audio. Set the URL and leave REC_CARD alone; the /dev/snd
#     passthrough in docker-compose.yml then becomes unnecessary and can be
#     commented out. This is the only option that works on Docker Desktop for
#     macOS and Windows, which have no host sound device to forward.
# RTSP_STREAM=rtsp://user:pass@192.168.1.50:554/stream

# Most USB mics are mono. Set 1 if arecord reports a single channel.
CHANNELS=2

# ---- detection tuning -------------------------------------------------------
# Minimum confidence (0.0-1.0) before a detection is recorded. Lower catches
# more and is wrong more often.
CONFIDENCE=0.7
# Detection sensitivity, 0.5-1.5.
SENSITIVITY=1.25
# Seconds of audio per analysis chunk.
RECORDING_LENGTH=15

# ---- optional ---------------------------------------------------------------
# Sets a password on /scripts, /stream, /terminal, /phpsysinfo and the file
# browser (username: birdnet). Empty means no auth at all, which is fine on a
# trusted LAN and not fine anywhere else.
CADDY_PWD=

# Hostname Caddy should answer on. Empty serves every host, which is what you
# want when reaching the container by IP or through a reverse proxy.
BIRDNETPI_URL=

# ---- the two web UIs --------------------------------------------------------
# The collage is always served on container port 80, published as 8080 by
# docker-compose.yml, i.e. http://<host>:8080/
#
# The stock BirdNET-Pi interface lives at /index.php on that same port. Set
# STOCK_UI_PORT to also serve it at "/" on a port of its own, which is nicer if
# you use it regularly: its relative links then resolve from the root rather
# than sitting under the collage.
#
# STOCK_UI_PORT is the CONTAINER port and must match the mapping in
# docker-compose.yml. STOCK_UI_HOST_PORT is the host side, if you want it
# published somewhere other than 8081.
#
# Empty means the collage is the only site. Both UIs remain reachable either
# way; this only changes whether the stock one gets its own root.
STOCK_UI_PORT=8081
STOCK_UI_HOST_PORT=8081

# Station ID if you also report to BirdWeather.
BIRDWEATHER_ID=

# Species name language for the database and UI.
DATABASE_LANG=en

# Container memory ceiling. tflite inference is the high-water mark; raise this
# if the analysis service is being OOM-killed, lower it on a 1GB Pi to protect
# the rest of the system.
MEM_LIMIT=1500m

# ---- optional: MQTT bridge --------------------------------------------------
# Publishes each newly heard species to MQTT as JSON under
# <MQTT_TOPIC_PREFIX>/<species-slug>, polling the detections API every
# MQTT_POLL_SECONDS. Useful for Home Assistant and friends.
#
# The service starts ONLY if MQTT_BROKER is non-empty. Leave it blank and
# nothing runs: `docker compose exec avianvisitors systemctl is-active
# avian_mqtt` will report inactive, which is the truth rather than an idle
# process pretending.
#
# Dedup is in-memory, so a restart re-publishes anything still inside the poll
# window. Harmless for sensors, worth knowing if you trigger automations.
MQTT_BROKER=
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=birdnet
MQTT_POLL_SECONDS=60

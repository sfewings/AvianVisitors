# Copy to .env and edit. Consumed by docker-compose.yml.
#
# Everything here is written into birdnet.conf every time the container starts,
# and overrides whatever the web UI has. Delete a line to hand that setting back
# to the UI.

# ---- required ---------------------------------------------------------------
# Only go to 4 decimal places. Used to weight the species list by location.
LATITUDE=-31.9523
LONGITUDE=115.8613

# ---- basics -----------------------------------------------------------------
TZ=Australia/Perth
SITE_NAME=AvianVisitors

# ---- audio source -----------------------------------------------------------
# Pick one.
#
# (a) USB microphone. Run `arecord -l` ON THE HOST and read off the card and
#     device numbers: "card 1: Device [USB Audio Device], device 0" is
#     plughw:1,0. Do NOT use "default" here: that routes through PulseAudio,
#     which the container deliberately does not run.
REC_CARD=plughw:1,0
RTSP_STREAM=

# (b) RTSP network audio. Set the URL and leave REC_CARD alone; the /dev/snd
#     passthrough in docker-compose.yml then becomes unnecessary and can be
#     commented out. This is the only option that works on Docker Desktop for
#     macOS and Windows, which have no host sound device to forward.
# RTSP_STREAM=rtsp://user:pass@192.168.1.50:554/stream

# Most USB mics are mono. Set 1 if arecord reports a single channel.
CHANNELS=2

# ---- detection tuning -------------------------------------------------------
# Minimum confidence (0.0-1.0) before a detection is recorded. Lower catches
# more and is wrong more often.
CONFIDENCE=0.7
# Detection sensitivity, 0.5-1.5.
SENSITIVITY=1.25
# Seconds of audio per analysis chunk.
RECORDING_LENGTH=15

# ---- optional ---------------------------------------------------------------
# Sets a password on /scripts, /stream, /terminal, /phpsysinfo and the file
# browser (username: birdnet). Empty means no auth at all, which is fine on a
# trusted LAN and not fine anywhere else.
CADDY_PWD=

# Hostname Caddy should answer on. Empty serves every host, which is what you
# want when reaching the container by IP or through a reverse proxy.
BIRDNETPI_URL=

# Station ID if you also report to BirdWeather.
BIRDWEATHER_ID=

# Species name language for the database and UI.
DATABASE_LANG=en

# Container memory ceiling. tflite inference is the high-water mark; raise this
# if the analysis service is being OOM-killed, lower it on a 1GB Pi to protect
# the rest of the system.
MEM_LIMIT=1500m

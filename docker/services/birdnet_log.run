#!/command/with-contenv bash
# Merge stderr into stdout so the s6-log pipeline captures both. Most of these
# programs report problems on stderr, and the admin overlay's log view only ever
# sees what the logger wrote, so without this their log files stay empty.
exec 2>&1
# Mirrors birdnet_log.service from install_services.sh. Caddy proxies /log here.
exec s6-setuidgid birdnet \
  env HOME=/home/birdnet USER=birdnet TERM=xterm-256color \
  /usr/local/bin/gotty --address localhost -p 8080 --path log \
    --title-format "BirdNET-Pi Log" birdnet_log.sh
